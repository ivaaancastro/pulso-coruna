# Nunca commitear valores reales
DATABASE_URL=postgres://pulso:pulso@localhost:5432/pulso
# Barcos (M5.1c). Sin clave o sin sal la fuente queda desactivada (aviso al arrancar). Clave: acción humana.
AISSTREAM_API_KEY=
# Sal del hash que sustituye al MMSI en el id público (cadena larga aleatoria: `openssl rand -hex 24`). No la cambies o los ids cambiarán.
SHIP_ID_SALT=
OPENSKY_USER=
OPENSKY_PASS=
# Aviones (OpenSky, M5.1d): solo "true" la activa. Anónimo: 400 créditos/día; 5 min = 288/día.
OPENSKY_ENABLED=false
OPENSKY_INTERVAL_MS=300000
# OAuth2 opcional (solo servidor; sin ellas, anónimo)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# iTranvías: desactivada hasta confirmar el permiso (M1.5). Solo "true" la activa.
ITRANVIAS_ENABLED=false
# Intervalo entre ciclos de 26 peticiones; el adaptador nunca baja de 15000.
ITRANVIAS_MIN_INTERVAL_MS=30000

# Portus (M5.1a): nivel del mar. API interna de su web, sin garantías: apagada por defecto.
PORTUS_ENABLED=false
# Aire MODELADO (Open-Meteo/CAMS, M5.1b): activo por defecto; "false" lo apaga.
OPENMETEO_AIR_ENABLED=true

# Buses ESTIMADOS por horario GTFS (M4.3a): posiciones teóricas, no reales. Activo por defecto.
SCHEDULE_ESTIMATES_ENABLED=true
# Intervalo del estimador (ms); nunca baja de 15000.
SCHEDULE_ESTIMATES_INTERVAL_MS=20000

# Herramientas de desarrollo (MCP), opcional. Exportarla en tu shell, Claude Code no lee .env solo.
CONTEXT7_API_KEY=

# Ingesta (apps/ingest). Los valores por defecto están en apps/ingest/src/config.ts
INGEST_TIMEOUT_MS=15000
INGEST_MAX_ATTEMPTS=3
INGEST_BACKOFF_BASE_MS=1000
INGEST_BACKOFF_MAX_MS=30000
INGEST_DOWN_AFTER=3
DB_CONNECT_TIMEOUT_S=10
DB_IDLE_TIMEOUT_S=30
DB_MAX_LIFETIME_S=1800
DB_STATEMENT_TIMEOUT_MS=15000
INGEST_MIGRATE_ATTEMPTS=10

# Producción (VPS): usa infra/deploy/.env.example (DOMAIN, POSTGRES_PASSWORD, backups). Ver docs/deploy.md

# API (apps/api). Todas opcionales; los valores por defecto están en apps/api/src/config.ts
API_PORT=3000
# Detrás de un proxy (Caddy en compose lo activa); en directo, false.
API_TRUST_PROXY=false
# `*` o lista separada por comas de orígenes (también se exige en el handshake WS).
API_CORS_ORIGINS=*
API_POLL_MS=2000
API_WS_MAX_PER_IP=10
API_WS_PING_MS=30000
# Cuánto tiempo sigue «viva» la última lectura de cada tipo (ms).
API_MAX_AGE_ENTITY_MS=300000
API_MAX_AGE_STATION_MS=3600000
API_MAX_AGE_OBSERVATION_MS=21600000
API_HEALTH_STALE_FACTOR=3
# Replay (M6.2): histórico máximo (días), días con datos brutos, límites y caché
API_REPLAY_MAX_AGE_DAYS=365
API_REPLAY_RAW_DAYS=28
API_REPLAY_MAX_ROWS=200000
API_REPLAY_MAX_BYTES=4194304
API_REPLAY_MAX_PER_IP=4
API_REPLAY_CACHE_BYTES=33554432
