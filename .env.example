# Nunca commitear valores reales
DATABASE_URL=postgres://pulso:pulso@localhost:5432/pulso
AISSTREAM_API_KEY=
OPENSKY_USER=
OPENSKY_PASS=
# iTranvías: desactivada hasta confirmar el permiso (M1.5). Solo "true" la activa.
ITRANVIAS_ENABLED=false
# Intervalo entre ciclos de 26 peticiones; el adaptador nunca baja de 15000.
ITRANVIAS_MIN_INTERVAL_MS=30000

# Herramientas de desarrollo (MCP), opcional. Exportarla en tu shell, Claude Code no lee .env solo.
CONTEXT7_API_KEY=

# Ingesta (apps/ingest). Los valores por defecto están en apps/ingest/src/config.ts
INGEST_TIMEOUT_MS=15000
INGEST_MAX_ATTEMPTS=3
INGEST_BACKOFF_BASE_MS=1000
INGEST_BACKOFF_MAX_MS=30000
INGEST_DOWN_AFTER=3
DB_CONNECT_TIMEOUT_S=10
DB_IDLE_TIMEOUT_S=30
DB_MAX_LIFETIME_S=1800
DB_STATEMENT_TIMEOUT_MS=15000
INGEST_MIGRATE_ATTEMPTS=10

# Producción (VPS): usa infra/deploy/.env.example (DOMAIN, POSTGRES_PASSWORD, backups). Ver docs/deploy.md
