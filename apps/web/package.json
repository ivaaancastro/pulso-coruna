{
  "name": "@pulso/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "icons": "node scripts/build-icons.mjs",
    "og": "node scripts/build-og.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "tiles:copy": "node scripts/copy-tiles.mjs",
    "dev:mock": "PULSO_MOCK_LIVE=1 vite"
  },
  "devDependencies": {
    "jsdom": "^31.0.1",
    "sharp": "0.34.5",
    "typescript": "^5.6.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.1",
    "@deck.gl/geo-layers": "9.4.1",
    "@deck.gl/layers": "9.4.1",
    "@deck.gl/maplibre": "9.4.1",
    "@msgpack/msgpack": "3.1.3",
    "@pulso/schema": "workspace:*",
    "maplibre-gl": "5.24.1",
    "pmtiles": "4.5.0"
  }
}
