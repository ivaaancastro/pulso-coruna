# Producción (infra/deploy). Copia a infra/deploy/.env; ese fichero NO se versiona.

# Dominio público que apunta (registro A/AAAA) al VPS. Caddy pide el certificado solo.
# Para probar en local deja `localhost` (certificado de la CA interna de Caddy).
DOMAIN=localhost

# Contraseña de PostgreSQL. Solo letras y dígitos (va dentro de una URL): `openssl rand -hex 24`
POSTGRES_PASSWORD=

# Puertos publicados por Caddy (en producción, los estándar).
HTTP_PORT=80
HTTPS_PORT=443

# Carpeta del host con coruna.pmtiles (ver infra/tiles/README.md) y carpeta de backups.
# Rutas relativas a infra/deploy/ (o absolutas).
TILES_DIR=./tiles
BACKUP_DIR=./backups

# Backup diario: hora UTC (HH:MM) y días que se conservan.
BACKUP_HOUR_UTC=03:30
BACKUP_KEEP_DAYS=14

# Ingesta. Todas opcionales (valores por defecto en apps/ingest/src/config.ts).
# iTranvías: desactivada hasta confirmar el permiso (M1.5). Solo "true" la activa.
ITRANVIAS_ENABLED=false
ITRANVIAS_MIN_INTERVAL_MS=30000
# Claves de fuentes con registro (M5). Vacías = esa fuente no se activa.
AISSTREAM_API_KEY=
# Sal del hash del MMSI (obligatoria para activar barcos): `openssl rand -hex 24`. Fija: cambiarla cambia los ids.
SHIP_ID_SALT=
OPENSKY_USER=
OPENSKY_PASS=

# API (M4.1). Todas opcionales (valores por defecto en apps/api/src/config.ts; lista completa en el .env.example de la raíz).
# Máximo de conexiones WebSocket simultáneas por IP.
API_WS_MAX_PER_IP=10
# Solo si la web se sirve desde otro dominio que la API; con Caddy en el mismo dominio no hace falta.
API_CORS_ORIGINS=*
# Vista previa de enlaces (M8.5): origen público de la web (https://<DOMAIN>). Sin valor, GET /api/v1/share da 404.
SHARE_BASE_URL=
