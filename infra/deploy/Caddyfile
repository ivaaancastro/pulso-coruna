# {$DOMAIN}: dominio público (HTTPS automático con Let's Encrypt). En local: localhost (CA interna de Caddy).
{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Teselas PMTiles propias (volumen del host, ver docs/deploy.md). Caddy atiende `Range`.
	handle_path /tiles/* {
		root * /srv/tiles
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# API (M4.1). `reverse_proxy` transporta WebSocket (/api/v1/stream) sin configuración extra y añade
	# X-Forwarded-For, que la API usa para el límite de conexiones por IP (API_TRUST_PROXY=true).
	# `encode` comprimiría el snapshot pero no toca el WebSocket; `flush_interval -1` evita retener deltas.
	handle /api/* {
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}

	handle {
		root * /srv/www
		# El service worker y el HTML siempre revalidan; los assets de Vite llevan hash en el nombre.
		@static path /assets/*
		header @static Cache-Control "public, max-age=31536000, immutable"
		@revalidate not path /assets/*
		header @revalidate Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
