# Caddy con la web (build de Vite) dentro. Contexto de build: raíz del repo.
FROM node:22.23.5-alpine AS web
RUN npm install -g pnpm@11.0.9
WORKDIR /repo
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json apps/web/
COPY apps/ingest/package.json apps/ingest/
COPY packages/schema/package.json packages/schema/
COPY packages/adapters/package.json packages/adapters/
RUN pnpm install --frozen-lockfile --filter "@pulso/web..."
COPY tsconfig.base.json ./
COPY packages packages
COPY apps/web apps/web
RUN pnpm --filter @pulso/web build

FROM caddy:2.11.9-alpine
COPY infra/deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=web /repo/apps/web/dist /srv/www
