# Imagen de apps/api (ADR-0017, mismo patrón que la ingesta). Contexto de build: raíz del repo.
#   docker build -f infra/deploy/Dockerfile.api -t pulso-api .
FROM node:22.23.5-alpine AS build
RUN npm install -g pnpm@11.0.9
WORKDIR /repo
# Primero solo los manifiestos: la capa de dependencias se cachea mientras no cambie el lockfile.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/api/package.json apps/api/
COPY packages/schema/package.json packages/schema/
RUN pnpm install --frozen-lockfile --filter "@pulso/api..."
COPY tsconfig.base.json ./
COPY packages/schema packages/schema
COPY apps/api apps/api
RUN pnpm --filter @pulso/api build

FROM node:22.23.5-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /repo/apps/api/dist/main.js ./main.js
USER node
EXPOSE 3000
# Sin curl en alpine: la sonda usa el propio node contra /api/v1/health.
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.API_PORT||3000)+'/api/v1/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
CMD ["node", "main.js"]
