# Imagen de apps/ingest (ADR-0017). Contexto de build: raíz del repo.
#   docker build -f infra/deploy/Dockerfile.ingest -t pulso-ingest .
FROM node:22.23.5-alpine AS build
RUN npm install -g pnpm@11.0.9
WORKDIR /repo
# Primero solo los manifiestos: la capa de dependencias se cachea mientras no cambie el lockfile.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/ingest/package.json apps/ingest/
COPY packages/schema/package.json packages/schema/
COPY packages/adapters/package.json packages/adapters/
RUN pnpm install --frozen-lockfile --filter "@pulso/ingest..."
COPY tsconfig.base.json ./
COPY packages packages
COPY apps/ingest apps/ingest
RUN pnpm --filter @pulso/ingest build

FROM node:22.23.5-alpine
ENV NODE_ENV=production \
    INGEST_MIGRATIONS_DIR=/app/migrations/
WORKDIR /app
COPY --from=build /repo/apps/ingest/dist/main.js ./main.js
COPY --from=build /repo/apps/ingest/migrations ./migrations
USER node
CMD ["node", "main.js"]
